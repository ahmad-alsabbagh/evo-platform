# Database
DATABASE_URL=postgresql://evo:evo_dev_password@localhost:5432/evo_platform

# LLM Provider (ollama, groq, openai, anthropic)
# Default: ollama (FREE, no API key needed)
LLM_PROVIDER=ollama
LLM_MODEL=llama3

# For Groq (FREE tier - sign up at https://console.groq.com)
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.1-70b-versatile
# GROQ_API_KEY=gsk_your_groq_key_here

# For OpenAI (paid)
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-your_openai_key_here

# For Anthropic (paid)
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-haiku-20240307
# ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here

# Server
HOST=0.0.0.0
PORT=8000
