{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://evo-platform.local/schemas/taxonomy.schema.json","title":"EvoPlatform Taxonomy","type":"object","additionalProperties":false,"required":["taxonomyVersion","category","slug"],"properties":{"taxonomyVersion":{"type":"string","pattern":"^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},"category":{"type":"string","minLength":1,"maxLength":100},"subcategory":{"type":"string","maxLength":100},"slug":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},"useCases":{"type":"array","items":{"type":"string","minLength":1}},"runtimes":{"type":"array","items":{"type":"string","minLength":1}},"integrations":{"type":"array","items":{"type":"string","minLength":1}},"riskLevel":{"type":"string","enum":["low","medium","high","critical"]}}}