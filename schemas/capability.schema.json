{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evo-platform.local/schemas/capability.schema.json",
  "title": "EvoPlatform Capability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "version",
    "title",
    "objective",
    "inputs",
    "outputs",
    "evaluation",
    "safety",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._/-]*$"
    },
    "kind": {
      "type": "string",
      "enum": ["prompt", "skill", "agent", "workflow", "tool", "composed"]
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)([-+][0-9A-Za-z.-]+)?$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description"],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "successCriteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/field"
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format"],
      "properties": {
        "format": {
          "type": "string",
          "enum": ["text", "markdown", "json", "structured", "binary"]
        },
        "schema": {
          "type": ["string", "object"]
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tool"
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pending", "partial", "passed", "failed"]
        },
        "dataset": {
          "type": "string"
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "report": {
          "type": "string"
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["riskLevel", "destructiveActions"],
      "properties": {
        "riskLevel": {
          "type": "string",
          "enum": ["low", "moderate", "high", "critical"]
        },
        "humanApprovalRequired": {
          "type": "boolean"
        },
        "destructiveActions": {
          "type": "string",
          "enum": ["denied", "approval_required", "allowed"]
        }
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "required"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$"
        },
        "type": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "default": {}
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sideEffects", "approval"],
      "properties": {
        "name": {
          "type": "string"
        },
        "sideEffects": {
          "type": "string",
          "enum": ["none", "read", "write", "destructive"]
        },
        "approval": {
          "type": "string",
          "enum": ["never", "conditional", "always"]
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceType", "license"],
      "properties": {
        "sourceType": {
          "type": "string",
          "enum": ["original", "adapted", "imported", "generated", "unknown"]
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        },
        "author": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "humanReviewed": {
          "type": "boolean"
        }
      }
    }
  }
}
