{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://evo-platform.local/schemas/promotion-policy.schema.json","title":"EvoPlatform Promotion Policy","type":"object","additionalProperties":false,"required":["policyVersion","minimumScore","minimumReproducibility","minimumTrust","allowedRiskLevels"],"properties":{"policyVersion":{"type":"string","pattern":"^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},"minimumScore":{"type":"number","minimum":0,"maximum":1},"minimumReproducibility":{"type":"number","minimum":0,"maximum":1},"minimumTrust":{"type":"number","minimum":0,"maximum":1},"allowedRiskLevels":{"type":"array","minItems":1,"items":{"type":"string","enum":["low","medium","high","critical"]}},"requireHumanReviewFor":{"type":"array","items":{"type":"string","enum":["low","medium","high","critical"]}},"requireRegressionPass":{"type":"boolean","default":true},"requireLicense":{"type":"boolean","default":true},"requireProvenance":{"type":"boolean","default":true}}}